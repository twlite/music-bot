DISCORD_TOKEN=replace-with-token-from-discord-developer-portal
DATABASE_URL=mongodb://127.0.0.1:27017/music-bot
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
PORT=5000
WEB_INTERFACE_URL=http://localhost:3000
REMEDIA_MODE=embedded
REMEDIA_URL=ws://127.0.0.1:8787
REMEDIA_USERNAME=media-bot
REMEDIA_PASSWORD=replace-with-a-long-random-password
CROSSFADE_ENABLED=false
CROSSFADE_DURATION_MS=5000
MEDIA_ALLOWED_HOSTS=cdn.discordapp.com,media.discordapp.net
SOCKET_REDIS_ADAPTER=false
SOURCE_PLUGIN_HOSTS=[]

# Optional: provider client ID if automatic SoundCloud discovery fails
SOUNDCLOUD_CLIENT_ID=
