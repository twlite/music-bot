# Secrets only. Edit app.config.json for all other bot settings.
DISCORD_TOKEN=replace-with-token-from-discord-developer-portal
# Optional: a credential-bearing MongoDB URI overrides database.url.
DATABASE_URL=
REDIS_PASSWORD=
REMEDIA_PASSWORD=replace-with-a-long-random-password
# Same secret as apps/stream-providers/.env.
STREAM_PROVIDERS_TOKEN=replace-with-a-long-random-token
